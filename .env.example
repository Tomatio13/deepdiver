# Core Strands model settings
STRANDS_MODEL_PROVIDER=
STRANDS_MODEL_CONFIG=

# Bedrock configuration (if STRANDS_MODEL_PROVIDER=bedrock)
BEDROCK_MODEL_ID=
STRANDS_MODEL_ID=
BEDROCK_REGION=
AWS_REGION=

# AWS credentials (used by Bedrock and other AWS services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI configuration (if STRANDS_MODEL_PROVIDER=openai)
OPENAI_MODEL=
OPENAI_API_KEY=

# Anthropic configuration (if STRANDS_MODEL_PROVIDER=anthropic)
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=

# Optional: path to additional JSON config
# STRANDS_MODEL_CONFIG can also point to a file, e.g. ./model-config.json
