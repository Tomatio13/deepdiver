# ============================================
# DDAWord CLI 環境変数設定例
# ============================================
# このファイルをコピーして .env を作成し、必要な設定を行ってください。
# python-dotenv により自動で読み込まれます。
# Strands Agentsのコマンド確認を抑止
STRANDS_TOOL_CONSOLE_MODE=disable
BYPASS_TOOL_CONSENT=True
# ツールの自動承認を有効化
DEEPDIVER_AUTO_APPROVE=True

# ============================================
# Prompt Injection Defender 設定
# ============================================
# 有効/無効
DEFENDER_ENABLED=true
# 既定動作: warn | sanitize | block
DEFENDER_DEFAULT_MODE=warn
# 警告を出すしきい値
DEFENDER_WARN_THRESHOLD=0.35
# 強い疑いとして扱うしきい値
DEFENDER_BLOCK_THRESHOLD=0.95
# sanitize時の挙動（現状は full-redact のみ）
DEFENDER_SANITIZE_MODE=full-redact

# /voiceコマンドを利用するための設定
# whisper.cpp CLI バイナリ（実行ファイルのフルパス）
DEEPDIVER_WHISPER_BIN=/path/to/whisper.cpp/build/bin/whisper-cli
# 文字起こしコマンドを明示的に指定したい場合のみ利用
# DEEPDIVER_WHISPER_CMD="{bin} -m {model} -f {audio} -l ja -otxt -of {out}"
# モデル設定（未指定なら ggml-base.bin）
DEEPDIVER_WHISPER_MODEL_DIR=~/.deepdiver/models/whisper
DEEPDIVER_WHISPER_MODEL=ggml-small.bin
# 録音設定
DEEPDIVER_VOICE_RECORDER=ffmpeg
DEEPDIVER_VOICE_SECONDS=20
# 無音自動停止（ffmpegのみ）
DEEPDIVER_VOICE_SILENCE_SECONDS=2
DEEPDIVER_VOICE_SILENCE_NOISE=-40dB

# ============================================
# モデルプロバイダの選択
# ============================================
# 利用可能なプロバイダ: bedrock, openai, anthropic, ollama, gemini
# 未指定の場合は、Strands Agent 側のデフォルト設定が利用されます。
STRANDS_MODEL_PROVIDER=openai

# ============================================
# Bedrock 設定例
# ============================================
# STRANDS_MODEL_PROVIDER=bedrock
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_REGION=us-east-1
# または
# STRANDS_MODEL_CONFIG='{"model_id": "anthropic.claude-3-5-sonnet-20241022-v2:0", "region_name": "us-east-1"}'

# ============================================
# OpenAI 設定例（標準のOpenAI API）
# ============================================
# STRANDS_MODEL_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-openai-key
# STRANDS_MODEL_CONFIG='{"model_id": "gpt-4o-mini", "params": {"temperature": 0.2}}'

# ============================================
# OpenAI 設定例（LiteLLMなどのOpenAI互換プロバイダ）
# ============================================
# STRANDS_MODEL_PROVIDER=openai
# OPENAI_MODEL_ID=gpt-4o-mini
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=http://localhost:4000/v1
# または、STRANDS_MODEL_CONFIGで設定することも可能:
# STRANDS_MODEL_CONFIG='{"client_args": {"api_key": "your-api-key", "base_url": "http://localhost:4000/v1"}, "model_id": "gpt-4o-mini"}'

# ============================================
# Anthropic 設定例
# ============================================
# STRANDS_MODEL_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ============================================
# Ollama 設定例
# ============================================
# STRANDS_MODEL_PROVIDER=ollama
# OLLAMA_MODEL=llama2
# STRANDS_MODEL_CONFIG='{"model_id": "llama2", "base_url": "http://localhost:11434"}'

# ============================================
# 共通設定
# ============================================
# STRANDS_MODEL_CONFIG は JSON文字列または JSON ファイルへのパスを指定できます。
# ファイルパスを指定した場合、CLI が内容を読み取ってマージします。
# 例: STRANDS_MODEL_CONFIG=./model-config.json

# AWS 資格情報（Bedrock を使用する場合）
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ============================================
# Gemini 設定例
# ============================================
# STRANDS_MODEL_PROVIDER=gemini
# GEMINI_MODEL_ID=gemini-2.5-flash
# GOOGLE_API_KEY=your-google-api-key
# または、GEMINI_API_KEYも使用可能
# GEMINI_API_KEY=your-google-api-key
# または、STRANDS_MODEL_CONFIGで設定することも可能:
# STRANDS_MODEL_CONFIG='{"client_args": {"api_key": "your-google-api-key"}, "model_id": "gemini-2.5-flash", "params": {"temperature": 0.7, "max_output_tokens": 2048}}'
